# Server-side only. Never expose this through browser-prefixed variables.
# Paste raw values without surrounding quotes or Markdown formatting.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Advanced reliability controls. Defaults are safe for Vercel's 30-second limit.
GEMINI_DEADLINE_MS=25000
GEMINI_HEDGE_DELAY_MS=4000
ALLOW_DEMO_FALLBACK=false
PORT=4173
